# Copy this file to .env.local and fill in real values.
# These three are safe to expose in the frontend bundle (Next.js inlines any
# NEXT_PUBLIC_-prefixed variable into the client build) — RLS is the real
# security boundary for NEXT_PUBLIC_SUPABASE_ANON_KEY, and
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY is designed by Paystack to be used client-side.
#
# NEVER put a service-role key, the Paystack SECRET key, or any
# notification-provider API key in a NEXT_PUBLIC_-prefixed variable here —
# those belong only in Supabase Edge Function secrets
# (`supabase secrets set ...` or the dashboard), never in a file that ships
# to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
